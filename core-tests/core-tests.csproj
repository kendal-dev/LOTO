<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Same language level as Unity 6000.4 so Core stays compatible. -->
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Loto.CoreTests</RootNamespace>
    <AssemblyName>core-tests</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core sources are linked, not copied: Unity owns the files. -->
    <Compile Include="..\unity\Assets\Loto\Core\*.cs" LinkBase="Core" />
  </ItemGroup>

</Project>
